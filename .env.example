# Copy to .env locally. Never commit the real .env file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
ALLOW_STUDENT_SIGNUP=false
# Opt-in only for localhost smoke tests without a database. Never enable on a public host.
ENABLE_LOCAL_DEMO_AUTH=false
LOCAL_DEMO_ADMIN_EMAIL=
LOCAL_DEMO_ADMIN_PASSWORD=
LOCAL_DEMO_STUDENT_EMAIL=
LOCAL_DEMO_STUDENT_PASSWORD=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ALLOWED_ORIGINS=https://mpc280702.github.io,http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_NAME=iw_session
PG_POOL_MAX=10